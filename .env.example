# 可选：复制为 .env；不复制也可使用以下默认值启动。
ENVIRONMENT=development
DEBUG=false
OPENAPI_ENABLED=true
# 按业务项目修改文档名称与说明；版本从已安装的项目元数据读取。
APP_TITLE='FastAPI Plus'
# APP_SUMMARY=业务 API 简介
# APP_DESCRIPTION=业务 API 使用说明
# 默认不启用跨域；填写 JSON 来源数组，协议/主机/端口必须匹配，不带末尾斜线。
# 使用 Bearer 请求头，不启用跨域 Cookie 凭据。
CORS_ALLOW_ORIGINS=[]
# CORS_ALLOW_ORIGINS=["http://localhost:5173","https://frontend.example.com"]
# 空列表关闭 Host 校验；部署时填写实际域名和探针使用的主机名，不含端口。
ALLOWED_HOSTS=[]
# ALLOWED_HOSTS=["api.example.com","localhost","127.0.0.1"]
# readiness 检查数据库及已启用 Redis 的总超时（秒）。
READINESS_TIMEOUT=3
# 可选 Prometheus；需安装 metrics extra，/metrics 仅向监控网络开放。
# 每个被采集地址运行一个进程，多实例逐个采集，详见 README。
METRICS_ENABLED=false
# LOG_FORMAT 控制控制台格式；未设置时开发/测试使用 console，生产使用 json。
# LOG_FORMAT=json
LOG_LEVEL=INFO
# 可选本地文件日志：UTF-8 JSON，10 MiB 轮转，保留 5 份备份。
# 单进程独占文件；多 Worker/prefork 使用 stderr 配合外部收集，详见 README。
# LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
# PostgreSQL/MySQL 需安装对应 extra，并同时配置匹配的异步连接串。
DATABASE=sqlite
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL/MySQL 每个 Web 进程的连接池；SQLite 忽略前三项，短期 NullPool 忽略队列池参数。
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
# 连接复用前的回收年龄（秒），-1 关闭回收；不是 SQL 执行超时。
DATABASE_POOL_RECYCLE=1800
# 生产必须设置至少 32 字节的随机 JWT_SECRET；不要提交真实秘密。
# 开发未设置时，每个应用实例使用随机临时密钥，重启后旧令牌失效。
# JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/storage
FILE_MAX_SIZE=10485760
# 整个请求体的原始字节上限，须大于 FILE_MAX_SIZE 并为 multipart 留余量。
REQUEST_MAX_BODY_SIZE=11534336
# 云后端完整变量与 extras 安装方法见 README 的“可选存储与任务”。
# 仅设置实际启用后端；秘密通过部署环境注入。
# 可选能力默认关闭；仅在启用时设置对应 URL，详见 README。
REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379/0
# 公网登录必须在此或接入层限流；应用层方案需同时启用 Redis。
# 每个客户端 IP 最多突发 5 次，此后按 5 次/60 秒补充；失败时返回 429 + Retry-After。
LOGIN_RATE_LIMIT_ENABLED=false
LOGIN_RATE_LIMIT_CAPACITY=5
LOGIN_RATE_LIMIT_PERIOD=60
# 同一应用的实例共用前缀和 Redis；不同应用应使用不同前缀。
LOGIN_RATE_LIMIT_PREFIX=fastplus:login
CELERY_ENABLED=false
# CELERY_BROKER_URL=redis://localhost:6379/1
# 省略结果后端时不保存任务结果。
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

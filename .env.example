# FastAPI Plus 配置示例
# 按需复制为 .env；未设置的项使用下列默认值。完整说明见 README“配置”一节。
# 秘密（JWT、数据库密码、云密钥）只写入本地 .env 或由部署环境注入，不要提交。

# ==================== 应用 ====================
# 运行环境：development / testing / production；生产必须关闭 DEBUG。
ENVIRONMENT=development
DEBUG=false
# 接口文档名称与说明；版本从已安装的项目元数据读取。
APP_TITLE='FastAPI Plus'
# APP_SUMMARY=业务 API 简介
# APP_DESCRIPTION=业务 API 使用说明
# 是否开放 /docs、/redoc 和 /openapi.json。
OPENAPI_ENABLED=true

# ==================== 跨域与主机 ====================
# 跨域来源 JSON 数组，空数组关闭 CORS；协议/主机/端口须精确匹配，不带末尾斜线。
# 认证使用 Bearer 请求头，不启用跨域 Cookie。
CORS_ALLOW_ORIGINS=[]
# CORS_ALLOW_ORIGINS=["http://localhost:5173","https://frontend.example.com"]
# Host 校验，空数组关闭；填写实际域名和探针使用的主机名，不含端口。
ALLOWED_HOSTS=[]
# ALLOWED_HOSTS=["api.example.com","localhost","127.0.0.1"]

# ==================== 健康检查与指标 ====================
# /health/ready 检查数据库及已启用 Redis 的总超时（秒）。
READINESS_TIMEOUT=3
# 可选 Prometheus /metrics，需安装 metrics extra，仅向监控网络开放。
# 每个被采集地址只运行一个进程，多实例逐个采集。
METRICS_ENABLED=false

# ==================== 日志 ====================
# 级别：DEBUG / INFO / WARNING / ERROR / CRITICAL。
LOG_LEVEL=INFO
# 控制台格式 console / json；未设置时开发/测试为 console，生产为 json。
# LOG_FORMAT=json
# 可选文件日志（UTF-8 JSON，按大小轮转）；同一文件只能由单个进程写入，
# 多 Worker/prefork 部署请改用 stderr 配合外部收集。
# LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# ==================== 数据库 ====================
# 类型：sqlite / postgresql / mysql；连接串必须使用对应的异步驱动。
# PostgreSQL/MySQL 需安装对应 extra，并预先创建数据库。
DATABASE=sqlite
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE=postgresql
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/app
# DATABASE=mysql
# DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/app?charset=utf8mb4
# 每个进程的连接池（PostgreSQL/MySQL）；SQLite 和短期 NullPool 忽略前三项。
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# 借连接等待超时（秒），不是 SQL 执行超时。
DATABASE_POOL_TIMEOUT=30
# 连接复用前的回收年龄（秒），-1 关闭回收。
DATABASE_POOL_RECYCLE=1800

# ==================== 认证 ====================
# 生产必须设置至少 32 字节的随机秘密，多进程/多实例使用同一值。
# 开发未设置时每个应用实例使用随机临时密钥，重启后旧令牌失效。
# JWT_SECRET=
# 访问令牌有效期 1–1440 分钟，刷新令牌有效期 1–365 天。
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 登录限流 ====================
# 公网登录应在此或接入层限流；应用层方案必须同时启用 Redis。
# 每个客户端 IP 最多突发 CAPACITY 次，此后按 CAPACITY 次/PERIOD 秒补充；超额返回 429。
LOGIN_RATE_LIMIT_ENABLED=false
LOGIN_RATE_LIMIT_CAPACITY=5
LOGIN_RATE_LIMIT_PERIOD=60
# 同一应用的多个实例共用前缀和 Redis；不同应用使用不同前缀。
LOGIN_RATE_LIMIT_PREFIX=fastplus:login

# ==================== 文件与请求体 ====================
# 单个文件上限（字节），默认 10 MiB。
FILE_MAX_SIZE=10485760
# 整个请求体原始字节上限，必须大于 FILE_MAX_SIZE，为 multipart 编码留余量。
REQUEST_MAX_BODY_SIZE=11534336

# ==================== 存储 ====================
# 默认后端：local / oss / cos；云后端需安装对应 extra。
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/storage
# 只填写实际启用后端的整组配置；切换默认后端后，历史文件仍需保留原后端配置。
# 阿里云 OSS
# STORAGE_OSS__BUCKET=your-bucket
# STORAGE_OSS__REGION=cn-hangzhou
# STORAGE_OSS__ACCESS_KEY_ID=由部署环境注入
# STORAGE_OSS__ACCESS_KEY_SECRET=由部署环境注入
# 腾讯云 COS：ACCESS_KEY_ID / ACCESS_KEY_SECRET 对应 SecretId / SecretKey
# STORAGE_COS__BUCKET=your-bucket-appid
# STORAGE_COS__REGION=ap-guangzhou
# STORAGE_COS__ACCESS_KEY_ID=由部署环境注入
# STORAGE_COS__ACCESS_KEY_SECRET=由部署环境注入

# ==================== Redis ====================
# 应用 Redis 客户端，登录限流依赖它；需安装 redis extra。
# 启用后会在启动、readiness 和 doctor 中检查连接。
REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379/0

# ==================== Celery 后台任务 ====================
# 与 REDIS_ENABLED 相互独立；需安装 celery extra，Worker 另行启动。
CELERY_ENABLED=false
# CELERY_BROKER_URL=redis://localhost:6379/1
# 省略结果后端时不保存任务结果。
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

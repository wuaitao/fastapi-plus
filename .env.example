# 可选：复制为 .env；不复制也可使用以下默认值启动。
ENVIRONMENT=development
DEBUG=false
OPENAPI_ENABLED=true
# 未设置 LOG_FORMAT 时开发/测试使用 console，生产使用 json；可显式覆盖。
# LOG_FORMAT=json
LOG_LEVEL=INFO
# PostgreSQL/MySQL 需安装对应 extra，并同时配置匹配的异步连接串。
DATABASE=sqlite
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# 生产必须设置至少 32 字节的随机 JWT_SECRET；不要提交真实秘密。
# 开发未设置时，每个应用实例使用随机临时密钥，重启后旧令牌失效。
# JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/storage
FILE_MAX_SIZE=10485760
# 云后端完整变量与 extras 安装方法见 docs/storage.md。
# 仅设置实际启用后端；秘密通过部署环境注入。
# 可选能力默认关闭；仅在启用时设置对应 URL，详见 docs/celery.md。
REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false
# CELERY_BROKER_URL=redis://localhost:6379/1
# 省略结果后端时不保存任务结果。
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

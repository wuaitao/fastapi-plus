# 可选：复制为 .env；不复制也可使用以下默认值启动。
ENVIRONMENT=development
DEBUG=false
OPENAPI_ENABLED=true
# 按业务项目修改文档名称与说明；版本从已安装的项目元数据读取。
APP_TITLE='FastAPI Plus'
# APP_SUMMARY=业务 API 简介
# APP_DESCRIPTION=业务 API 使用说明
# 默认不启用跨域；填写 JSON 来源数组，协议/主机/端口必须匹配，不带末尾斜线。
# 使用 Bearer 请求头，不启用跨域 Cookie 凭据。
CORS_ALLOW_ORIGINS=[]
# CORS_ALLOW_ORIGINS=["http://localhost:5173","https://frontend.example.com"]
# LOG_FORMAT 控制控制台格式；未设置时开发/测试使用 console，生产使用 json。
# LOG_FORMAT=json
LOG_LEVEL=INFO
# 可选本地文件日志：UTF-8 JSON，10 MiB 轮转，保留 5 份备份。
# 单进程独占文件；多 Worker/prefork 使用 stderr 配合外部收集，详见 README。
# LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
# PostgreSQL/MySQL 需安装对应 extra，并同时配置匹配的异步连接串。
DATABASE=sqlite
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# 生产必须设置至少 32 字节的随机 JWT_SECRET；不要提交真实秘密。
# 开发未设置时，每个应用实例使用随机临时密钥，重启后旧令牌失效。
# JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/storage
FILE_MAX_SIZE=10485760
# 云后端完整变量与 extras 安装方法见 README 的“可选存储与任务”。
# 仅设置实际启用后端；秘密通过部署环境注入。
# 可选能力默认关闭；仅在启用时设置对应 URL，详见 README。
REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false
# CELERY_BROKER_URL=redis://localhost:6379/1
# 省略结果后端时不保存任务结果。
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
